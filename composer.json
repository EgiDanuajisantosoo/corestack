{
    "name": "corestack/arch-support",
    "description": "Reusable Laravel architecture package.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "ramsey/uuid": "^4.7"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Corestack\\ArchSupport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corestack\\ArchSupport\\ArchServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "egi danuajisantoso",
            "email": "oneeeback@gmail.com"
        }
    ],
    "minimum-stability": "stable"
}
